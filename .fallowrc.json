{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/client.tsx",
    "src/server.ts",
    "server/plugins/**/*.ts",
    "server/routes/**/*.ts",
    "scripts/field-presence.ts"
  ],
  "ignorePatterns": [".storybook/**", "src/routeTree.gen.ts"],
  "ignoreDependencies": [
    "@chromatic-com/storybook",
    "@shikijs/core",
    "@shikijs/engine-javascript",
    "@storybook/addon-a11y",
    "@storybook/addon-docs",
    "agentation"
  ],
  "ignoreExports": [
    {
      "file": "src/components/markdown-article.module.css",
      "exports": ["*"]
    },
    {
      "file": "src/components/session-chat.tsx",
      "exports": ["SessionChatProps"]
    },
    {
      "file": "src/components/settings-provider.tsx",
      "exports": ["SettingsProvider"]
    },
    {
      "file": "src/lib/active-sessions.ts",
      "exports": ["ActiveSession"]
    },
    {
      "file": "src/lib/hook-events.ts",
      "exports": [
        "PendingApprovalPayload",
        "NotificationEntryPayload",
        "NotificationClearedPayload"
      ]
    },
    {
      "file": "src/lib/pending-approvals.ts",
      "exports": ["scanAllPendingApprovals", "PendingApprovalToolName", "PendingApproval"]
    },
    {
      "file": "src/lib/db/pending-approvals-cache.ts",
      "exports": [
        "initPendingApprovalsCache",
        "getPendingApprovals",
        "getPendingApprovalsForProject",
        "updatePendingApprovalForSession",
        "removePendingApprovalForSession"
      ]
    },
    {
      "file": "src/lib/claude-light-theme.ts",
      "exports": ["claudeLight"]
    },
    {
      "file": "src/lib/db/index.ts",
      "exports": ["runInitialScan", "awaitInitialScan"]
    },
    {
      "file": "src/lib/api/approvals.ts",
      "exports": ["ApprovalsResponse", "approvalsQueryOptions", "projectApprovalsQueryOptions"]
    },
    {
      "file": "src/lib/api/notifications.ts",
      "exports": [
        "Notification",
        "NotificationsData",
        "notificationsQueryOptions",
        "projectNotificationsQueryOptions",
        "useDismissNotification",
        "useClearNotifications"
      ]
    },
    {
      "file": "src/lib/api/tmux.ts",
      "exports": ["tmuxWindowsQueryOptions"]
    },
    {
      "file": "src/lib/api/sessions.ts",
      "exports": ["SessionSubagentsResponse", "sessionSubagentsQueryOptions"]
    },
    {
      "file": "src/lib/db/queries.ts",
      "exports": [
        "DbSearchResult",
        "DbMessageSearchResult",
        "listPlansFromDb",
        "getMemoryCountsForProjects",
        "getMemoriesForProject",
        "MemoryRow",
        "getPlanFilenameForSession"
      ]
    },
    {
      "file": "src/lib/sessions.ts",
      "exports": ["RawWindow", "readSessionLines"]
    },
    {
      "file": "src/routes/session.$id_.source.$uuid.tsx",
      "exports": ["PairedResult"]
    },
    {
      "file": "src/components/tool-renderers/shared.tsx",
      "exports": ["CopyButton"]
    },
    {
      "file": "src/lib/settings-fields.ts",
      "exports": ["OBJECT_EDITORS", "COVERED_SETTINGS_KEYS"]
    },
    {
      "file": "src/lib/update-dedupe.ts",
      "exports": ["*"]
    },
    {
      "file": "src/lib/watcher.ts",
      "exports": ["*"]
    },
    {
      "file": "src/lib/herdr/availability.ts",
      "exports": ["*"]
    },
    {
      "file": "src/lib/herdr/subscribe.ts",
      "exports": ["*"]
    }
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn",
    "unused-types": "error",
    "unused-exports": "error",
    "duplicate-exports": "error"
  }
}
