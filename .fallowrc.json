{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"entry": ["scripts/field-presence.ts"],
	"ignorePatterns": [".storybook/**", "src/routeTree.gen.ts"],
	"ignoreDependencies": ["@shikijs/core", "@shikijs/engine-javascript", "@spotlightjs/spotlight", "agentation"],
	"ignoreExports": [
		{"file": "src/components/markdown-article.module.css", "exports": ["*"]},
		{"file": "src/components/session-chat.tsx", "exports": ["SessionChatProps"]},
		{"file": "src/components/settings-provider.tsx", "exports": ["SettingsProvider"]},
		{"file": "src/lib/active-sessions.ts", "exports": ["ActiveSession"]},
		{"file": "src/lib/db/queries.ts", "exports": ["DbSearchResult", "DbMessageSearchResult"]},
		{"file": "src/lib/server-fns.ts", "exports": ["ProjectScopeBase"]},
		{"file": "src/lib/sessions.ts", "exports": ["RawWindow", "readSessionLines"]},
		{"file": "src/routes/session.$id_.source.$uuid.tsx", "exports": ["PairedResult"]}
	],
	"rules": {
		"unused-dependencies": "warn",
		"unused-types": "error",
		"unused-exports": "error",
		"duplicate-exports": "warn"
	}
}
