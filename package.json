{
  "name": "claude-code-plans",
  "version": "1.0.0",
  "description": "Persistent HTTP server that serves Claude Code plans with syntax highlighting and real-time updates",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "start": "node .output/server/index.mjs",
    "build": "vp build",
    "oxlint": "vp lint . --fix",
    "oxlint:ci": "vp lint . --format github",
    "fmt": "vp fmt",
    "fmt:ci": "vp fmt --check",
    "fallow": "fallow fix --yes",
    "fallow:ci": "fallow dead-code",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vp test",
    "test:run": "vp test --run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@git-diff-view/react": "^0.1.5",
    "@mdxeditor/editor": "^4.0.1",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-devtools": "^5.100.14",
    "@tanstack/react-router": "^1.170.10",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.18",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^5.0.0",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.17.0",
    "markdown-it": "^14.2.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "agentation": "^3.0.2",
    "drizzle-kit": "^0.31.10",
    "fallow": "^2.85.0",
    "markdownlint-cli2": "^0.22.1",
    "nitro": "^3.0.260522-beta",
    "storybook": "^10.4.1",
    "tailwindcss": "^4.2.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.1.1"
}
