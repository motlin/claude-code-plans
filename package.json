{
  "name": "claude-code-browser",
  "version": "1.0.0",
  "description": "Claude Code Browser: a persistent HTTP server that browses your Claude Code data with syntax highlighting and real-time updates",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vp dev",
    "preview": "vp preview",
    "start": "node .output/server/index.mjs",
    "build": "vp build && tsgo --noEmit",
    "oxlint": "vp lint . --fix",
    "oxlint:ci": "vp lint . --format github",
    "fmt": "vp fmt",
    "fmt:ci": "vp fmt --check",
    "fallow": "fallow fix --yes",
    "fallow:ci": "fallow dead-code",
    "mcp": "tsx mcp-server/index.ts",
    "typecheck": "tsgo --noEmit",
    "test": "node node_modules/vitest/dist/cli.js",
    "test:ui": "node node_modules/vitest/dist/cli.js --ui",
    "test:run": "node node_modules/vitest/dist/cli.js run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "VITE_GIT_HOOKS=0 vp config"
  },
  "dependencies": {
    "@git-diff-view/core": "^0.1.7",
    "@git-diff-view/react": "^0.1.7",
    "@mdxeditor/editor": "^4.2.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-query-devtools": "^5.102.3",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.35",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "ghostty-web": "0.4.0",
    "lucide-react": "^1.34.0",
    "markdown-it": "^14.3.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "nitro": "3.0.260522-beta",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.0",
    "agentation": "^3.0.2",
    "fallow": "^3.18.0",
    "jsdom": "^30.0.1",
    "markdownlint-cli2": "^0.23.1",
    "playwright": "^1.62.1",
    "storybook": "^10.5.10",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.15.0"
}
