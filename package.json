{
  "name": "claude-code-browser",
  "version": "1.0.0",
  "description": "Claude Code Browser: a persistent HTTP server that browses your Claude Code data with syntax highlighting and real-time updates",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vp dev",
    "preview": "vp preview",
    "start": "node .output/server/index.mjs",
    "build": "vp build && tsgo --noEmit",
    "oxlint": "vp lint . --fix",
    "oxlint:ci": "vp lint . --format github",
    "fmt": "vp fmt",
    "fmt:ci": "vp fmt --check",
    "fallow": "fallow fix --yes",
    "fallow:ci": "fallow dead-code",
    "typecheck": "tsgo --noEmit",
    "test": "node node_modules/vitest/dist/cli.js",
    "test:ui": "node node_modules/vitest/dist/cli.js --ui",
    "test:run": "node node_modules/vitest/dist/cli.js run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "npx concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"npx http-server storybook-static --port 6006 --silent\" \"npx wait-on tcp:127.0.0.1:6006 && test-storybook\"",
    "prepare": "VITE_GIT_HOOKS=0 vp config"
  },
  "dependencies": {
    "@git-diff-view/react": "^0.1.7",
    "@mdxeditor/editor": "^4.1.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.34",
    "better-sqlite3": "^13.0.2",
    "chokidar": "^5.0.0",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.28.0",
    "markdown-it": "^14.3.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.0.5",
    "agentation": "^3.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "fallow": "^3.11.0",
    "jsdom": "^30.0.1",
    "markdownlint-cli2": "^0.23.1",
    "nitro": "^3.0.260522-beta",
    "playwright": "^1.62.1",
    "storybook": "^10.5.5",
    "tw-animate-css": "^1.4.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.15.0"
}
