{
	"name": "claude-code-browser",
	"version": "1.0.0",
	"description": "Claude Code Browser: a persistent HTTP server that browses your Claude Code data with syntax highlighting and real-time updates",
	"type": "module",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "vp dev",
		"preview": "vp preview",
		"start": "node .output/server/index.mjs",
		"build": "vp build",
		"oxlint": "vp lint . --fix",
		"oxlint:ci": "vp lint . --format github",
		"fmt": "vp fmt",
		"fmt:ci": "vp fmt --check",
		"fallow": "fallow fix --yes --no-create-config",
		"fallow:ci": "fallow dead-code",
		"mcp": "tsx mcp-server/index.ts",
		"test": "node node_modules/vitest/dist/cli.js",
		"test:ui": "node node_modules/vitest/dist/cli.js --ui",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"prepare": "VITE_GIT_HOOKS=0 vp config"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@fontsource/opendyslexic": "5.3.0",
		"@mdxeditor/editor": "^4.3.3",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@pierre/diffs": "^1.6.1",
		"@pierre/theme": "^2.0.0",
		"@tanstack/react-query": "^5.104.2",
		"@tanstack/react-query-devtools": "^5.104.2",
		"@tanstack/react-router": "^1.170.18",
		"@tanstack/react-router-ssr-query": "^1.167.2",
		"@tanstack/react-start": "^1.168.35",
		"better-sqlite3": "^13.0.3",
		"chokidar": "^5.0.0",
		"cmdk": "^1.1.1",
		"drizzle-orm": "^0.45.4",
		"ghostty-web": "0.4.0",
		"jsonc-parser": "3.3.1",
		"lucide-react": "^1.61.0",
		"markdown-it": "^14.3.0",
		"markdown-it-footnote": "^4.0.0",
		"markdown-it-task-lists": "^2.1.1",
		"nitro": "3.0.260522-beta",
		"node-pty": "1.2.0-beta.15",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"shiki": "^4.5.0",
		"tailwindcss": "^4.3.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.6.0",
		"@storybook/addon-a11y": "^10.6.3",
		"@storybook/addon-docs": "^10.6.3",
		"@storybook/react-vite": "^10.6.3",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/react": "^16.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"agentation": "^3.1.2",
		"eslint-plugin-storybook": "^10.6.3",
		"fallow": "^3.34.1",
		"jsdom": "^30.1.3",
		"markdownlint-cli2": "^0.24.0",
		"playwright": "^1.64.1",
		"storybook": "^10.6.3",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@12.12.1"
}
