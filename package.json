{
	"name": "claude-code-plans",
	"version": "1.0.0",
	"description": "Persistent HTTP server that serves Claude Code plans with syntax highlighting and real-time updates",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"start": "node serve.js",
		"build": "vite build",
		"eslint": "eslint . --fix",
		"eslint:ci": "eslint . --format json --output-file eslint_report.json",
		"biome": "npx biome format --write .",
		"biome:ci": "npx biome format .",
		"typecheck": "tsc --noEmit -p tsconfig.check.json",
		"test": "vitest",
		"test:run": "vitest run",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@git-diff-view/core": "^0.1.3",
		"@git-diff-view/react": "^0.1.3",
		"@mdxeditor/editor": "^3.55.0",
		"@shikijs/markdown-it": "^4.0.2",
		"@tanstack/react-query": "^5.99.2",
		"@tanstack/react-query-devtools": "^5.99.2",
		"@tanstack/react-router": "^1.167.5",
		"@tanstack/react-router-ssr-query": "^1.166.11",
		"@tanstack/react-start": "^1.167.42",
		"better-sqlite3": "^12.9.0",
		"chokidar": "^5.0.0",
		"cmdk": "^1.1.1",
		"drizzle-orm": "^0.45.2",
		"github-markdown-css": "^5.9.0",
		"lucide-react": "^1.8.0",
		"markdown-it": "^14.1.0",
		"markdown-it-footnote": "^4.0.0",
		"markdown-it-task-lists": "^2.1.1",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"shiki": "^4.0.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.12",
		"@chromatic-com/storybook": "^5.1.2",
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "^10.3.5",
		"@storybook/addon-docs": "^10.3.5",
		"@storybook/addon-vitest": "^10.3.5",
		"@storybook/react-vite": "^10.3.5",
		"@tailwindcss/vite": "^4.2.4",
		"@types/better-sqlite3": "^7.6.13",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript-eslint/eslint-plugin": "^8.59.0",
		"@typescript-eslint/parser": "^8.59.0",
		"@vitejs/plugin-react": "^6.0.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.2.1",
		"eslint-plugin-storybook": "^10.3.5",
		"globals": "^17.5.0",
		"jiti": "^2.6.1",
		"storybook": "^10.3.5",
		"tailwindcss": "^4.2.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.9",
		"vitest": "^4.1.5"
	}
