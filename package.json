{
	"name": "claude-code-plans",
	"version": "1.0.0",
	"description": "Persistent HTTP server that serves Claude Code plans with syntax highlighting and real-time updates",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"start": "node .output/server/index.mjs",
		"build": "vite build",
		"eslint": "eslint . --fix",
		"eslint:ci": "eslint . --format json --output-file eslint_report.json",
		"biome": "npx biome format --write .",
		"biome:ci": "npx biome format .",
		"typecheck": "tsc --noEmit -p tsconfig.check.json",
		"test": "vitest",
		"test:run": "vitest run"
	},
	"dependencies": {
		"@mdxeditor/editor": "^3.52.4",
		"@shikijs/markdown-it": "^4.0.2",
		"@tanstack/react-router": "^1.166.7",
		"@tanstack/react-start": "^1.166.8",
		"better-sqlite3": "^12.6.2",
		"chokidar": "^5.0.0",
		"drizzle-orm": "^0.45.1",
		"lucide-react": "^0.577.0",
		"markdown-it": "^14.1.0",
		"markdown-it-footnote": "^4.0.0",
		"markdown-it-task-lists": "^2.1.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"shiki": "^4.0.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.6",
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.2.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^25.5.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript-eslint/eslint-plugin": "^8.57.0",
		"@typescript-eslint/parser": "^8.57.0",
		"@vitejs/plugin-react": "^5.1.4",
		"drizzle-kit": "^0.31.9",
		"eslint": "^10.0.3",
		"globals": "^17.3.0",
		"jiti": "^2.6.1",
		"tailwindcss": "^4.2.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.0"
	}
}
