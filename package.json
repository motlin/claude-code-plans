{
  "name": "claude-code-browser",
  "version": "1.0.0",
  "description": "Claude Code Browser: a persistent HTTP server that browses your Claude Code data with syntax highlighting and real-time updates",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vp dev",
    "preview": "vp preview",
    "start": "node .output/server/index.mjs",
    "build": "vp build && tsgo --noEmit",
    "oxlint": "vp lint . --fix",
    "oxlint:ci": "vp lint . --format github",
    "fmt": "vp fmt",
    "fmt:ci": "vp fmt --check",
    "fallow": "fallow fix --yes",
    "fallow:ci": "fallow dead-code",
    "typecheck": "tsgo --noEmit",
    "test": "node node_modules/vitest/dist/cli.js",
    "test:ui": "node node_modules/vitest/dist/cli.js --ui",
    "test:run": "node node_modules/vitest/dist/cli.js run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "npx concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"npx http-server storybook-static --port 6006 --silent\" \"npx wait-on tcp:127.0.0.1:6006 && test-storybook\"",
    "prepare": "vp config"
  },
  "dependencies": {
    "@git-diff-view/react": "^0.1.6",
    "@mdxeditor/editor": "^4.0.4",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.26",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.22.0",
    "markdown-it": "^14.2.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.4.6",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260630.1",
    "@vitejs/plugin-react": "^6.0.3",
    "agentation": "^3.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "fallow": "^2.103.0",
    "jsdom": "^29.1.1",
    "markdownlint-cli2": "^0.22.1",
    "nitro": "^3.0.260522-beta",
    "playwright": "^1.61.1",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.1.1"
}
